{
	"type": "module",
	"name": "@oh-my-pi/collab-desktop",
	"version": "0.1.0",
	"private": true,
	"description": "Desktop app for omp collab: runs this computer's companion and shows the collab web app in its own window, with a menu-bar icon, native notifications and a self-updater",
	"homepage": "https://omp.sh",
	"author": {
		"name": "Stencil Labs, Inc.",
		"url": "https://stencil.so"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/can1357/oh-my-pi.git",
		"directory": "packages/collab-desktop"
	},
	"bugs": {
		"url": "https://github.com/can1357/oh-my-pi/issues"
	},
	"main": "dist/main.cjs",
	"scripts": {
		"build": "bun scripts/build.ts",
		"dev": "bun scripts/dev.ts",
		"pack": "bun scripts/package.ts --dir",
		"dist": "bun scripts/package.ts",
		"icons": "bun scripts/make-icons.ts",
		"smoke": "bun scripts/smoke.ts",
		"test": "bun test",
		"check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts' && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "oxlint .",
		"fix": "oxlint --fix --fix-suggestions . && bun run fmt",
		"fmt": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts'"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"electron": "catalog:",
		"electron-builder": "catalog:",
		"playwright-core": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
