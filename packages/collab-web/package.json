{
  "type": "module",
  "name": "@oh-my-pi/collab-web",
  "version": "16.3.6",
  "private": true,
  "description": "Browser guest client and local relay tools for omp collab live sessions",
  "homepage": "https://omp.sh",
  "author": { "name": "Stencil Labs, Inc.", "url": "https://stencil.so" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/can1357/oh-my-pi.git",
    "directory": "packages/collab-web"
  },
  "bugs": {
    "url": "https://github.com/can1357/oh-my-pi/issues"
  },
  "keywords": [
    "collab",
    "relay",
    "websocket",
    "react",
    "agent"
  ],
  "scripts": {
    "dev": "bun ./index.html",
    "mock-host": "bun scripts/mock-host.ts",
    "companion": "bun scripts/companion.ts",
    "relay": "bun scripts/local-relay.ts",
    "build": "rm -rf dist && bun build ./index.html --outdir=dist --minify --splitting --define process.env.NODE_ENV='\"production\"' --entry-naming=[hash].[ext] --chunk-naming=[hash].[ext] --asset-naming=[hash].[ext] && mv dist/*.html dist/index.html && cp -R public/. dist/ && bun scripts/build-sw.ts",
    "gen:tool-views": "bun scripts/build-tool-views.ts",
    "prepack": "bun run build",
    "test": "bun test --parallel",
    "check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts' && bun run check:types",
    "check:types": "tsgo -p tsconfig.json --noEmit",
    "lint": "oxlint .",
    "fix": "oxlint --fix --fix-suggestions . && bun run fmt",
    "fmt": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts'"
  },
  "dependencies": {
    "@codemirror/autocomplete": "catalog:",
    "@codemirror/commands": "catalog:",
    "@codemirror/lang-cpp": "catalog:",
    "@codemirror/lang-css": "catalog:",
    "@codemirror/lang-go": "catalog:",
    "@codemirror/lang-html": "catalog:",
    "@codemirror/lang-java": "catalog:",
    "@codemirror/lang-javascript": "catalog:",
    "@codemirror/lang-json": "catalog:",
    "@codemirror/lang-markdown": "catalog:",
    "@codemirror/lang-python": "catalog:",
    "@codemirror/lang-rust": "catalog:",
    "@codemirror/lang-sql": "catalog:",
    "@codemirror/lang-yaml": "catalog:",
    "@codemirror/language": "catalog:",
    "@codemirror/legacy-modes": "catalog:",
    "@codemirror/search": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@lezer/highlight": "catalog:",
    "@oh-my-pi/omp-stats": "catalog:",
    "@oh-my-pi/pi-coding-agent": "catalog:",
    "@oh-my-pi/pi-utils": "catalog:",
    "@oh-my-pi/pi-wire": "catalog:",
    "d3-force": "catalog:",
    "diff": "catalog:",
    "highlight.js": "catalog:",
    "highlightjs-solidity": "catalog:",
    "jsqr": "catalog:",
    "katex": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@oh-my-pi/pi-tui": "catalog:",
    "@types/d3-force": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "puppeteer-core": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "public",
    "index.html",
    "README.md",
    "CHANGELOG.md"
  ]
}
